{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rentmap",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // 部署版本:彙總快取的鍵帶它,重新部署後舊結果自動失效(cache.ts)
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // 前端 SPA 靜態檔:vite build 產到 dist/client;找不到的路徑回 index.html 交給前端路由
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/area", "/area/*", "/sitemap.xml"]
  },
  // 正式網域(shunzz.com 的 DNS 在 Cloudflare;憑證自動發)
  "routes": [{ "pattern": "lokanote.shunzz.com", "custom_domain": true }],
  // 非機密設定(正式站的值)。本機 dev 由 .dev.vars 覆寫 APP_ORIGIN=http://localhost:5173。
  // 機密(GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / SESSION_SECRET / INGEST_SECRET)雲端用 `wrangler secret put`,本機放 .dev.vars。
  // 正式站不設 PRIVATE_POOL(= 公開模式)、不設 DEV_USER_EMAIL。
  "vars": {
    "APP_ORIGIN": "https://lokanote.shunzz.com",
    "ADMIN_EMAILS": "m23568n@gmail.com",
    // 站長:永遠完整版、看得到營運儀表板 /admin(src/worker/owner.ts)
    "OWNER_EMAILS": "m23568n@gmail.com"
  },
  // 本機 dev 走 .wrangler/state 的本地 SQLite(不會碰遠端);正式站是 2026-10-08 建的 rentmap-db(亞太)。
  // preview_database_id 決定本機那份檔名:留 local-placeholder,本機才會接到原本的資料(改成正式 id 會變成一份空的)。
  "d1_databases": [
    { "binding": "DB", "database_name": "rentmap-db", "database_id": "cbd48da7-f3b2-400b-92f8-04429a1dc8b5", "preview_database_id": "local-placeholder", "migrations_dir": "migrations" }
  ]
}
