{
  "name": "rentmap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc -b",
    "test": "vitest run",
    "types": "node scripts/types.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply rentmap-db --local",
    "deploy": "echo 部署前先問過使用者 && exit 1",
    "collect": "tsx collector/cli.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-router": "^1.170.38",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "lucide-react": "^1.47.0",
    "maplibre-gl": "^6.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@cloudflare/vitest-plugin": "^1.1.13",
    "@cloudflare/workers-types": "^5.20260920.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.135.0"
  }
